<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_history_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgRiwayat"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:background="@drawable/bg_image_preview"
        android:contentDescription="Gambar riwayat"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNamaDaunRiwayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Daun"
            android:textColor="#1B5E20"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtConfidenceRiwayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Confidence: -"
            android:textColor="#555555"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtWaktuRiwayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Waktu"
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>